# astroagent settings, read by skills/nebulis/scripts/nebulis.py
# Copy to ~/.config/astroagent/env and run: chmod 600 ~/.config/astroagent/env
# Environment variables with the same names take precedence over this file.
ASTROAGENT_NEBULIS_URL=http://your-server:3001
ASTROAGENT_NEBULIS_API_KEY=neb-xxxxxxxxxxxxxxxx
